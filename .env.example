# Copy to .env (repo root or backend/) and fill in. NEVER commit .env.
# The challenge forbids exposing the team key in code, logs, screenshots or videos.

# --- Platform (values given by the organisers) ---------------------------
EDNOVA_BASE_URL=http://localhost:9000/v1     # mock server by default
EDNOVA_API_KEY=replace-me

# Model names per class: run `curl -H "Authorization: Bearer $EDNOVA_API_KEY" $EDNOVA_BASE_URL/models`
COMPACT_MODEL=mock-compact-1.5b
MIDSIZE_MODEL=mock-mid-14b
EMBEDDING_MODEL=mock-embed

# --- Client-side limits ----------------------------------------------------
MAX_CONCURRENCY=2          # keep below the per-key concurrent-request ceiling
REQUEST_TIMEOUT_S=180      # CPU-only inference: mid-size can take a while
MAX_QUOTA_WAITS=3          # how many times to wait on "quota exhausted" before giving up
MAX_RETRY_AFTER_S=60       # never wait longer than this on a single delay

# --- Admin ---------------------------------------------------------------
ADMIN_TOKEN=               # protects the degraded-mode switch; set it before any public demo

# --- Local development with Ollama instead of the mock ------------------------
# EDNOVA_BASE_URL=http://localhost:11434/v1
# EDNOVA_API_KEY=ollama
# COMPACT_MODEL=qwen2.5:1.5b
# MIDSIZE_MODEL=qwen2.5:14b
# EMBEDDING_MODEL=nomic-embed-text
